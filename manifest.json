{
  "manifest_version": 3,
  "name": "Vessel – Privacy-First Agent",
  "version": "1.2",
  "description": "Privacy-first agentic firewall with Active Defense & Galaxy Handoff.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Vessel"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}