{
  "manifest_version": 3,
  "name": "Vessel – Privacy-First Agent",
  "version": "1.1",
  "description": "Privacy-first agentic firewall for credential protection",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Vessel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
