{
    "manifest_version": 3,
    "name": "Vessel - Local Agent",
    "version": "0.1.0",
    "description": "A privacy-first web agent running locally.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "offscreen"
    ],
    
    "host_permissions": [
        "http://localhost:11434/",
        "http://127.0.0.1:11434/" 
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "minimum_chrome_version": "116",
    "content_security_policy": {
        
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" 
    }
}