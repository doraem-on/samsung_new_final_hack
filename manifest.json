{
  "manifest_version": 3,
  "name": "Vessel – Privacy-First Agent",
  "version": "1.1",
  "description": "Offline, on-device AI agent with semantic memory and agentic firewall.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "sidePanel"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Open Vessel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "xenova-transformers.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
