{
  "manifest_version": 3,
  "name": "Vessel - Privacy-First Agent",
  "version": "1.0",
  "description": "Offline, on-device agent with Agentic Firewall.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Vessel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["xenova-transformers.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}